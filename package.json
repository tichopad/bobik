{
  "name": "bobik",
  "version": "0.1.0",
  "description": "A single-purpose CLI AI agent for Markdown notes",
  "type": "module",
  "bin": {
    "bobik": "./bin/bobik.mjs"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "notes",
    "markdown"
  ],
  "author": "Michael Tichopad",
  "license": "ISC",
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@ai-sdk/fireworks": "2.0.95",
    "ai": "6.0.310",
    "bash-tool": "1.3.19",
    "citty": "0.2.2",
    "just-bash": "3.6.0",
    "picomatch": "4.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
